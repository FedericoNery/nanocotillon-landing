---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import MarcasCarousel from "../components/MarcasCarousel.astro";
import IconInstagram from "../components/icons/IconInstagram.astro";
import IconFacebook from "../components/icons/IconFacebook.astro";
import { getWhatsappHref } from "../lib/whatsapp";

const pasos = [
  { numero: "1", titulo: "Elegí", descripcion: "Recorré el catálogo y armá tu lista de productos." },
  { numero: "2", titulo: "Consultá", descripcion: "Escribinos por WhatsApp para confirmar stock y precio." },
  { numero: "3", titulo: "Retirá o coordiná envío", descripcion: "Pasá por el local o coordinamos el envío." },
];
---

<BaseLayout title="Inicio">
  <section class="relative overflow-hidden bg-surface py-20 sm:py-24">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <span class="absolute left-[6%] top-[18%] h-2 w-5 -rotate-12 rounded-full bg-brand-red/70"></span>
      <span class="absolute left-[16%] top-[72%] h-2.5 w-6 rotate-45 rounded-full bg-brand-blue/60"></span>
      <span class="absolute left-[4%] top-[48%] h-1.5 w-4 rotate-6 rounded-full bg-brand-yellow/70"></span>
      <span class="absolute right-[10%] top-[12%] h-2 w-5 rotate-12 rounded-full bg-brand-magenta/60"></span>
      <span class="absolute right-[5%] top-[45%] h-2.5 w-6 -rotate-45 rounded-full bg-brand-celeste/70"></span>
      <span class="absolute right-[18%] top-[78%] h-2 w-5 rotate-90 rounded-full bg-brand-orange/60"></span>
      <span class="absolute right-[28%] top-[25%] h-1.5 w-4 -rotate-6 rounded-full bg-brand-red/50"></span>
      <span class="absolute left-[30%] top-[8%] h-2 w-5 rotate-45 rounded-full bg-brand-blue/50"></span>
    </div>

    <Container>
      <div class="relative z-10 max-w-2xl">
        <h1 class="font-display text-4xl font-extrabold text-ink sm:text-5xl">
          Todo para tu fiesta, en un solo lugar
        </h1>
        <p class="mt-4 text-lg text-ink/80">
          Chocolate para repostería, moldes, dulce de leche repostero y todo lo dulce para tus tortas, más cotillón,
          descartables y golosinas para el candy bar de tu próximo festejo.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/productos"
            class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-3 text-sm font-bold text-surface transition hover:brightness-110"
          >
            Ver catálogo
          </a>
          <a
            href={getWhatsappHref()}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border border-border bg-white px-6 py-3 text-sm font-bold text-ink transition hover:bg-surface-alt"
          >
            Escribinos por WhatsApp
          </a>
        </div>
      </div>
    </Container>

    <svg
      aria-hidden="true"
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
      class="absolute inset-x-0 bottom-0 z-10 block h-10 w-full text-surface-alt sm:h-14 md:h-16"
    >
      <path
        fill="currentColor"
        d="M0,0 C32,0 40,68 90,68 C140,68 148,0 180,0 C212,0 220,68 270,68 C320,68 328,0 360,0 C392,0 400,68 450,68 C500,68 508,0 540,0 C572,0 580,68 630,68 C680,68 688,0 720,0 C752,0 760,68 810,68 C860,68 868,0 900,0 C932,0 940,68 990,68 C1040,68 1048,0 1080,0 C1112,0 1120,68 1170,68 C1220,68 1228,0 1260,0 C1292,0 1300,68 1350,68 C1400,68 1408,0 1440,0 L1440,120 L0,120 Z"
      ></path>
    </svg>
  </section>

  <section class="bg-surface-alt py-12">
    <Container>
      <h2 class="text-center font-display text-sm font-bold uppercase tracking-wide text-ink-soft">
        Marcas que trabajamos
      </h2>
      <div class="mt-6">
        <MarcasCarousel />
      </div>
    </Container>
  </section>

  <section class="overflow-x-clip bg-surface-alt py-16">
    <Container>
      <h2 class="font-display text-3xl font-bold text-ink">Cómo comprar</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        {
          pasos.map((paso) => (
            <div class="flex flex-col gap-3 rounded-card border border-border bg-surface p-6 shadow-md transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none">
              <span class="badge-scallop flex h-14 w-14 items-center justify-center bg-brand-blue font-display text-lg font-bold text-white">
                {paso.numero}
              </span>
              <h3 class="font-display text-lg font-bold text-ink">{paso.titulo}</h3>
              <p class="text-sm text-ink-soft">{paso.descripcion}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="overflow-x-clip py-16">
    <Container>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="relative flex flex-col items-start gap-4 overflow-hidden rounded-card bg-surface-alt p-6 pt-8 text-ink shadow-md transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none sm:p-8 sm:pt-10">
          <div
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-3 bg-[linear-gradient(to_right,var(--color-brand-celeste)_0,var(--color-brand-celeste)_33.33%,white_33.33%,white_66.66%,var(--color-brand-celeste)_66.66%,var(--color-brand-celeste)_100%)] sm:h-4"
          ></div>
          <div>
            <h2 class="font-display text-xl font-bold">Fiestas Patrias</h2>
            <p class="mt-2 text-sm text-ink/80">
              Escarapelas, banderines y cotillón celeste y blanco para el 25 de Mayo y el 9 de Julio.
            </p>
          </div>
          <a
            href="/productos/fiestas-patrias"
            class="inline-flex shrink-0 items-center justify-center rounded-full bg-brand-blue px-5 py-2.5 text-sm font-bold text-white transition hover:brightness-110"
          >
            Ver productos
          </a>
        </div>

        <div class="relative flex flex-col items-start gap-4 overflow-hidden rounded-card bg-surface-alt p-6 pt-8 text-ink shadow-md transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none sm:p-8 sm:pt-10">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-3 bg-brand-yellow sm:h-4"></div>
          <div>
            <h2 class="font-display text-xl font-bold">Comuniones y Confirmaciones</h2>
            <p class="mt-2 text-sm text-ink/80">
              Recuerdos, centros de mesa y cotillón elegante para celebrar este día tan especial.
            </p>
          </div>
          <a
            href="#"
            class="inline-flex shrink-0 items-center justify-center rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-surface transition hover:brightness-110"
          >
            Ver productos
          </a>
        </div>

        <div class="relative flex flex-col items-start gap-4 overflow-hidden rounded-card bg-[repeating-linear-gradient(45deg,var(--color-ink)_0,var(--color-ink)_40px,var(--color-brand-orange)_40px,var(--color-brand-orange)_80px)] p-6 shadow-md transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none sm:p-8">
          <div class="absolute inset-0 bg-black/35"></div>
          <div class="relative">
            <h2 class="font-display text-xl font-bold text-white">Halloween</h2>
            <p class="mt-2 text-sm text-white/90">
              Disfraces, decoración terrorífica y golosinas para la noche más espeluznante del año.
            </p>
          </div>
          <a
            href="#"
            class="relative inline-flex shrink-0 items-center justify-center rounded-full bg-brand-yellow px-5 py-2.5 text-sm font-bold text-ink transition hover:brightness-105"
          >
            Ver productos
          </a>
        </div>

        <div class="relative flex flex-col items-start gap-4 overflow-hidden rounded-card bg-[repeating-linear-gradient(45deg,var(--color-ink)_0,var(--color-ink)_40px,var(--color-brand-magenta)_40px,var(--color-brand-magenta)_80px)] p-6 shadow-md transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lg motion-reduce:transition-none sm:p-8">
          <div class="absolute inset-0 bg-black/35"></div>
          <div class="relative">
            <h2 class="font-display text-xl font-bold text-white">Despedidas de Solteros</h2>
            <p class="mt-2 text-sm text-white/90">
              Cotillón, accesorios y decoración para una despedida inolvidable.
            </p>
          </div>
          <a
            href="#"
            class="relative inline-flex shrink-0 items-center justify-center rounded-full bg-white px-5 py-2.5 text-sm font-bold text-ink transition hover:brightness-95"
          >
            Ver productos
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section class="overflow-x-clip bg-surface-alt py-16">
    <Container>
      <h2 class="font-display text-3xl font-bold text-ink">Seguinos</h2>
      <p class="mt-2 text-ink-soft">Novedades y catálogo actualizado en nuestras redes.</p>
      <div class="mt-6 flex gap-4">
        <a
          href="https://www.instagram.com/nanocotillon/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-magenta px-6 py-3 text-sm font-bold text-white transition hover:brightness-110"
        >
          <IconInstagram class="h-5 w-5" />
          Instagram
        </a>
        <a
          href="https://www.facebook.com/nanocotillon"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-red px-6 py-3 text-sm font-bold text-white transition hover:brightness-110"
        >
          <IconFacebook class="h-5 w-5" />
          Facebook
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
