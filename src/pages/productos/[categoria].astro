                icono={categoria.data.icono}
              />
            ))}
          </div>
        ) : (
          <p class="mt-8 text-ink-soft">Todavía no hay productos cargados en esta categoría.</p>
        ) */
      }
    </Container>
  </section>
</BaseLayout>
