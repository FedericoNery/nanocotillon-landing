---
import { Image } from "astro:assets";

interface Props {
  categoria: string;
}

const { categoria } = Astro.props;

const imagenes = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/productos/*/*.{jpeg,jpg,png,webp}", { eager: true }),
)
  .filter(([path]) => path.includes(`/productos/${categoria}/`))
  .map(([path, mod]) => {
    const alt = path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "")
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase());

    return { alt, src: mod.default };
  });
---

{
  imagenes.length > 0 && (
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {imagenes.map((imagen) => (
        <div
          class="group relative aspect-square overflow-hidden rounded-card border border-border bg-white"
          tabindex="0"
        >
          <Image
            src={imagen.src}
            alt={imagen.alt}
            width={400}
            format="webp"
            quality={75}
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-x-0 bottom-0 translate-y-full bg-black/60 px-3 py-2 opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100">
            <p class="text-sm font-medium text-white">{imagen.alt}</p>
          </div>
        </div>
      ))}
    </div>
  )
}
