---
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://nanocotillon.com.ar";

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Nano Cotillón",
  url: siteUrl,
  image: `${siteUrl}/og-image.png`,
  telephone: "+5491121879513",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Lafuente 3121",
    addressLocality: "Ciudad Autónoma de Buenos Aires",
    postalCode: "C1437",
    addressCountry: "AR",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:30",
      closes: "13:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "16:00",
      closes: "18:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "08:30",
      closes: "13:00",
    },
  ],
  sameAs: ["https://www.instagram.com/nanocotillon/", "https://www.facebook.com/nanocotillon"],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
