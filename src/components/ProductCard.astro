---
interface Props {
  nombre: string;
  descripcion: string;
  icono: string;
}

const { nombre, descripcion, icono } = Astro.props;
---

<div class="flex flex-col gap-3 rounded-card border border-border bg-white p-6">
  <div class="flex h-16 w-16 items-center justify-center rounded-card bg-surface-alt text-3xl">
    {icono}
  </div>
  <h3 class="text-base font-bold text-ink">{nombre}</h3>
  <p class="text-sm text-ink-soft">{descripcion}</p>
</div>
