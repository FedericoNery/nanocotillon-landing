---
import { Image } from "astro:assets";

const logos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/logos-marcas/*.{png,jpg,jpeg,svg,webp}", { eager: true }),
).map(([path, mod]) => {
  const nombre = path
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "")
    .replace(/[-_]/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());

  return { nombre, src: mod.default };
});

// Se duplica la lista para que la animación de scroll sea continua.
const logosLoop = [...logos, ...logos];
---

<div class="marcas-carousel group relative overflow-hidden mask-[linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]">
  <div class="marcas-track flex w-max items-center gap-10 group-hover:[animation-play-state:paused]">
    {
      logosLoop.map((logo) => (
        <div class="flex h-20 w-40 shrink-0 items-center justify-center rounded-card border border-border bg-white px-4 grayscale transition hover:grayscale-0">
          <Image src={logo.src} alt={logo.nombre} class="max-h-12 max-w-full object-contain" loading="lazy" />
        </div>
      ))
    }
  </div>
</div>

<style>
  .marcas-track {
    animation: marcas-scroll 30s linear infinite;
  }

  @keyframes marcas-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marcas-track {
      animation: none;
    }
  }
</style>
